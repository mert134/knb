# Discord Developer Portal > Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord server ID (Developer Mode > right-click server > Copy Server ID)
GUILD_ID=

# Set this to your deployed Render service URL + /auth/callback
# Example: https://your-service.onrender.com/auth/callback
DISCORD_REDIRECT_URI=

# Use a long random value (at least 32 characters)
SESSION_SECRET=

# Render supplies PORT automatically. Locally, defaults to 3000.
PORT=3000
NODE_ENV=development
